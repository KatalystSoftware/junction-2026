# The on-call shift replay (projects/oncallbench/replay): static files, no container. Its deploy.sh
# puts them in /srv/katalyst/proxy/static/incident, which the proxy sees under /etc/caddy.
incident.{$BASE_DOMAIN} {
	encode zstd gzip
	import cache
	import access
	root * /etc/caddy/static/incident
	file_server
}
