# Kutsu (projects/kutsu): a systemd service on the machine itself (talent-brief.service, port 8046),
# not a container. It listens only on the gateway address of the `proxy` network, which this container
# reaches and the internet does not, so this proxy is the only way in.
kutsu.{$BASE_DOMAIN} {
	encode zstd gzip
	import cache
	import access
	reverse_proxy 172.19.0.1:8046
}
