 "sql": [
  {
   "label": "Gap queue",
   "query": "-- Gap queue: one row per topic and edition to fix, by impact\nSELECT q.wikidata_id, q.topic, q.lang, q.rich_lang, q.readers, q.coverage,\n       COUNT(f.id) AS findings,\n       LEAST(1, (1 - q.coverage) + 0.1 * COALESCE(SUM(f.weight), 0)) AS gap,\n       ROUND(q.readers * LEAST(1, (1 - q.coverage) + 0.1 * COALESCE(SUM(f.weight), 0))) AS score\nFROM topic_edition q\nLEFT JOIN finding f\n  ON f.wikidata_id = q.wikidata_id AND f.lang = q.lang\n AND f.status = 'open' AND f.type <> 'coverage'\nGROUP BY q.wikidata_id, q.lang\nORDER BY score DESC\nLIMIT 50 OFFSET 0;",
   "ms": 1.7,
   "rows": 22
  }
 ]
